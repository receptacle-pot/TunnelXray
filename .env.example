# SMTP Configuration for Real Email OTP Authentication
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-google-app-password
SMTP_FROM="TunnelXray Security Operations" <your-email@gmail.com>

# Optional OAuth Credentials (Leave blank if not using OAuth providers)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Production Port (defaults to 3000)
PORT=3000
